{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "general": { },
    "logo": {
        "type": "builtin",
        "source": "arch_small",
        "color": {
            "1": "magenta",
            "2": "magenta"
      }
    },
    "display": {
        "color": {
            "keys": "blue",
            "title": "magenta"
        },
    },
    "modules": [
      "title",
      "separator",
      {
          "type": "os",
          "key": "OS",
          "keyColor": "blue",
          "format": "{name}",
      },
      {
          "type": "kernel",
          "key": "Kernel",
          "keyColor": "yellow",
      },
      {
          "type": "cpu",
          "format": "{name}",
          "keyColor": "red",
      },
      {
        "type": "gpu",
        "keyColor": "green",
        "format": "{name}"
      },
      {
          "type": "memory",
          "keyColor": "cyan",
          "key": "Memory",
      }
    ]
}
