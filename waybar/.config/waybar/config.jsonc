{
  "layer": "bottom",
  "position": "top",
  "height": 36,
  "margin-top": 3,
  "margin-bottom": 3,
  "margin-left": 256,
  "margin-right": 256,
  "reload_style_on_change": true,
  "modules-left": ["hyprland/workspaces"],
  "modules-right": ["wireplumber", "battery", "clock"],
  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
        "1": "one",
        "2": "two",
        "3": "three",
        "4": "four",
        "5": "five",
        "6": "six",
        "7": "seven",
        "8": "eight",
        "9": "nine",
        "10": "ten",
    },
    "tooltip": false,
  },
  "clock": {
    "interval": 60,
    "format": "{:%H:%M %a %b %d}",
    "tooltip": false
  },
  "tray": {
    "icon-size": 16,
    "spacing": 5,
    "tooltip": true
  },
  "network": {
    "format-wifi": "{icon}",
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤮",
    "tooltip": false,
    "on-click": "ghostty -e nmtui",
  },
  "wireplumber": {
    "format": "{volume}% {icon}",
    "format-muted": "󰝟",
    "format-icons": ["", "", ""],
    "scroll-step": 1,
    "tooltip": false,
    "on-click": "pavucontrol"
  },
  "battery": {
    "interval": 30,
    "format": "{capacity}% {icon}",
    "format-charging": "{capacity}% 󰂄",
    "tooltip": true,
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
  }
}
