{
  "layer": "bottom",
  "position": "top",
  "margin": 2,
  "reload_style_on_change": true,
  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["mpris"],
  "modules-right": ["tray", "network", "wireplumber", "battery", "clock"],
  "hyprland/workspaces": {
    "tooltip": false,
  },
  "mpris": {
    "format": "{player_icon} {dynamic}",
    "format-paused": "{status_icon} <i>{dynamic}</i>",
    "dynamic-len": 50,
    "interval": 10,
    "tooltip": false,
    "player-icons": {
      "default": "",
    },
    "status-icons": {
      "paused": "",
    },
    "ignored-players": [],
  },
  "tray": {
    "icon-size": 18,
    "spacing": 8,
    "tooltip": false,
    "icons": {},
  },
  "network": {
    "format-wifi": "",
    "format-ethernet": "",
    "format-disconnected": "Disconnected",
    "tooltip": false,
    "max-length": 50
  },
  "wireplumber": {
    "format": " {icon} {volume}%",
    "format-muted": "",
    "on-click": "pavucontrol",
    "max-volume": 100,
    "tooltip": false,
    "format-icons": ["", "", ""],
  },
  "battery": {
    "interval": 60,
    "tooltip": false,
    "states": {
      "warning": 30,
      "critical": 15,
    },
    "format": "{icon} {capacity}%",
    "format-icons": {
      "default": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
      "charging": ["󰢟", "󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"],
    },
  },
  "clock": {
    "interval": 60,
    "format": " {:%m-%d %H:%M}",
    "max-length": 25,
    "tooltip": false,
  },
}
