{
  "layer": "bottom",
  "position": "top",
  "margin-top": 24,
  "margin-left": 24,
  "margin-right": 24,
  "reload_style_on_change": true,
  "include": [
    "~/.config/waybar/modules.jsonc"
  ],
  "modules-left": [
    "hyprland/workspaces",
  ],
  "modules-center": [
    
  ],
  "modules-right": [
    "tray",
    "wireplumber",
    "network",
    "battery",
    "group/clock-pill"
  ],
  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
        "1": "one",
        "2": "two",
        "3": "three",
        "4": "four",
        "5": "five",
        "6": "six",
        "7": "seven",
        "8": "eight",
        "9": "nine",
        "10": "ten",
    },
    "tooltip": false,
  },
  "group/clock-pill": {
    "orientation": "horizontal",
    "modules": [
      "clock#date",
      "clock#time",
    ],
  },
  "tray": {
    "icon-size": 16,
    "spacing": 8,
  },
  "network": {
    "format-wifi": "{icon}",
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤮",
    "tooltip": false,
    "on-click": "kitty -e nmtui",
  },
  "wireplumber": {
    "format": "{volume}% {icon}",
    "format-muted": "󰝟",
    "format-icons": ["", "", ""],
    "scroll-step": 1,
    "tooltip": false,
    "on-click": "pavucontrol"
  },
  "battery": {
    "interval": 30,
    "format": "{capacity}% {icon}",
    "format-charging": "{capacity}% 󰂄",
    "tooltip": true,
    "states": {
      "warning": 40,
      "critical": 25
    },
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
  }
}
