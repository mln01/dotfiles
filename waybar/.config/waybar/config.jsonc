{
    "layer": "top",
    "position": "top",
    "spacing": 6,
    "modules-left": [
        "hyprland/workspaces",
        "mpris"
    ],
    "modules-right": [
        "tray",
        "privacy",
        "wireplumber",
        "backlight",
        "battery",
        "clock"
    ],
    "mpris": {
        "format": "{player_icon} {dynamic}",
        "format-paused": "{status_icon} <i>{dynamic}</i>",
        "dynamic-len": 50,
        "interval": 10,
        "player-icons": {
            "default": "▶",
            "chromium": "󰎆",
            "mpv": "🎵"
        },
        "status-icons": {
            "paused": "⏸"
        },
        "ignored-players": []
    },
    "tray": {
        "icon-size": 21,
        "spacing": 10,
        "icons": {}
    },
    "privacy": {
        "icon-spacing": 4,
        "icon-size": 18,
        "transition-duration": 250,
        "modules": [
            {
                "type": "screenshare",
                "tooltip": true,
                "tooltip-icon-size": 24
            },
            {
                "type": "audio-out",
                "tooltip": true,
                "tooltip-icon-size": 24
            },
            {
                "type": "audio-in",
                "tooltip": true,
                "tooltip-icon-size": 24
            }
        ],
        "ignore-monitor": true,
        "ignore": [
            {
                "type": "audio-in",
                "name": "cava"
            },
            {
                "type": "screenshare",
                "name": "obs"
            }
        ],
    },
    "wireplumber": {
        "format": "{icon} {volume}%",
        "format-muted": "",
        "on-click": "alacritty -e wiremix",
        "max-volume": 100,
        "format-icons": [
            "",
            "",
            ""
        ]
    },
    "backlight": {
        "device": "intel_backlight",
        "format": "{icon} {percent}%",
        "format-icons": [
            "󰃛",
            "󰃞"
        ]
    },
    "battery": {
        "interval": 60,
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-icons": [
            "",
            "",
            "",
            "",
            ""
        ],
        "max-length": 25
    },
    "clock": {
        "interval": 60,
        "format": "{:%m-%d %H:%M}",
        "max-length": 25
    }
}
