{
  "layer": "bottom",
  "position": "top",
  "margin-top": 24,
  "margin-left": 24,
  "margin-right": 24,
  "reload_style_on_change": true,
  "include": [
    "~/.config/waybar/modules.jsonc"
  ],
  "modules-left": [
    "hyprland/workspaces",
  ],
  "modules-center": [
    
  ],
  "modules-right": [
    "tray",
    "wireplumber",
    "bluetooth",
    "network",
    "battery",
    "group/clock-pill"
  ],
  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
        "1": "one",
        "2": "two",
        "3": "three",
        "4": "four",
        "5": "five",
        "6": "six",
        "7": "seven",
        "8": "eight",
        "9": "nine",
        "10": "ten",
    },
    "tooltip": false,
  },
  "group/clock-pill": {
    "orientation": "horizontal",
    "modules": [
      "clock#date",
      "clock#time",
    ],
  },
  "tray": {
    "icon-size": 16,
    "spacing": 8,
  },
  "network": {
    "format-wifi": "{icon}",
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤮",
    "tooltip": false,
    "on-click": "kitty --class wifitui -e wifitui",
  },
  "wireplumber": {
    "format": "{volume}% {icon}",
    "format-muted": "󰝟",
    "format-icons": ["", "", ""],
    "scroll-step": 1,
    "tooltip": false,
    "on-click": "kitty --class wiremix -e wiremix"
  },
  "bluetooth": {
  	"format": " {status}",
  	"format-disabled": "󰂲 {status}", // an empty format will hide the module
    "format-connected-battery": " {device_alias} {device_battery_percentage}%",
  	"format-connected": " {num_connections} connected",
  	"tooltip-format": "{controller_alias}\t{controller_address}",
  	"tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
  	"tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
  	"tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}%",
  	"on-click": "kitty --class bluetui -e bluetui"
  },
  "battery": {
    "interval": 30,
    "format": "{capacity}% {icon}",
    "format-charging": "{capacity}% 󰂄",
    "tooltip": true,
    "states": {
      "warning": 40,
      "critical": 25
    },
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
  }
}
