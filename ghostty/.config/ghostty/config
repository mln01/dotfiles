font-family = JetBrains Mono Medium
font-size = 16.6
theme = Catppuccin Frappe

shell-integration-features = no-cursor
cursor-style = block
cursor-style-blink = false
mouse-hide-while-typing = true

alpha-blending = native
window-padding-x = 3
window-padding-y = 3

keybind = alt+h=goto_split:left
keybind = alt+j=goto_split:down
keybind = alt+k=goto_split:up
keybind = alt+l=goto_split:right

keybind = alt+u=new_split:down
keybind = alt+i=new_split:right

keybind = alt+f=toggle_split_zoom

keybind = alt+q=close_surface

keybind = alt+y=copy_to_clipboard
